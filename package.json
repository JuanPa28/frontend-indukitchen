{
  "name": "frontend-indukitchen",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "clean": "rimraf dist",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "e2e": "start-server-and-test start http://localhost:4200 cypress:run",
    "e2e:open": "start-server-and-test start http://localhost:4200 cypress",
    "test:coverage": "ng test --watch=false --code-coverage",
    "cypress:coverage": "start-server-and-test start http://localhost:4200 'cypress run && nyc report'"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.3",
    "@angular/compiler": "^20.3.3",
    "@angular/core": "^20.3.3",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.3.3",
    "@angular/platform-browser-dynamic": "^20.3.3",
    "@angular/router": "^20.3.3",
    "@auth0/angular-jwt": "^5.2.0",
    "bootstrap": "^5.3.8",
    "firebase": "^12.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^20.0.0",
    "@angular-devkit/build-angular": "^20.3.4",
    "@angular/build": "^20.2.1",
    "@angular/cli": "^20.3.4",
    "@angular/compiler-cli": "^20.3.3",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@cypress/code-coverage": "^3.14.7",
    "@cypress/webpack-preprocessor": "^7.0.1",
    "@types/jasmine": "~5.1.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-istanbul": "^7.0.1",
    "chromedriver": "^141.0.1",
    "cypress": "^15.5.0",
    "istanbul-lib-coverage": "^3.2.2",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nyc": "^17.1.0",
    "selenium-webdriver": "^4.36.0",
    "start-server-and-test": "^2.1.2",
    "ts-loader": "^9.5.4",
    "typescript": "~5.9.2",
    "webpack": "^5.102.1"
  }
}
