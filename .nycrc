{
  "all": true,
  "check-coverage": true,
  "report-dir": "coverage-cypress",
  "reporter": ["html", "lcov", "text", "text-summary", "json"],
  "extension": [".ts"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.e2e.js",
    "**/environments/**",
    "**/node_modules/**",
    "cypress/**",
    "coverage/**",
    "coverage-cypress/**",
    "dist/**"
  ],
  "sourceMap": true,
  "instrument": true,
  "produce-source-map": true
}
